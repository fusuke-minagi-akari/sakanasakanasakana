[Unit]
Description=Poll status.claude.com for the Claude Code statusline
Documentation=https://status.claude.com/api

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
ExecStart=/usr/bin/env bash %h/.claude/scripts/claude-status/poll.sh
# Notifications: herdr (socket, always works) + notify-send (needs the user
# session bus, which systemd --user already provides).
