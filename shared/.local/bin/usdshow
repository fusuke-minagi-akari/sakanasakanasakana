#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.10,<3.13"
# dependencies = ["usd-core", "trimesh", "scipy", "numpy", "pyglet<2"]
# ///
"""View a USD stage's meshes in an interactive trimesh window.

usdshow <file.usd|.usda|.usdc|.usdz>

Handles UsdGeomMesh prims only (the common case for asset previews): world
transforms are baked in via each prim's local-to-world xform, n-gon faces are
fan-triangulated, and constant/vertex primvars:displayColor becomes the mesh
color. Skinning, animation and other prim types (points, curves) are not
resolved — this is a lightweight preview, not usdview.

mouse  left drag orbit · scroll zoom · right drag / shift+left pan
keys   z toggle wireframe · a toggle axes · q/esc quit
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

import numpy as np
import trimesh
from pxr import Usd, UsdGeom

PROG = "usdshow"


def fan_triangulate(counts: list[int], indices: list[int]) -> np.ndarray:
    """Fan-triangulate polygon faces (correct for triangles/quads, a fine
    approximation for convex n-gons — ponytail: no ear-clipping for concave faces).
    """
    tris = []
    i = 0
    for c in counts:
        face = indices[i : i + c]
        for k in range(1, c - 1):
            tris.append((face[0], face[k], face[k + 1]))
        i += c
    return np.array(tris, dtype=np.int64).reshape(-1, 3)


def mesh_color(mesh: "UsdGeom.Mesh", n_verts: int) -> np.ndarray | None:
    primvar = mesh.GetDisplayColorPrimvar()
    values = primvar.Get()
    if not values:
        return None
    rgb = (np.clip(np.array(values, dtype=np.float64), 0.0, 1.0) * 255).astype(np.uint8)
    if len(rgb) == 1:
        rgb = np.tile(rgb, (n_verts, 1))
    elif len(rgb) != n_verts:
        return None  # faceVarying/uniform interpolation not resolved — skip color
    alpha = np.full((n_verts, 1), 255, dtype=np.uint8)
    return np.hstack([rgb, alpha])


def load_usd_scene(path: Path) -> trimesh.Scene:
    stage = Usd.Stage.Open(str(path))
    if stage is None:
        sys.exit(f"{PROG}: failed to open stage: {path}")

    scene = trimesh.Scene()
    n_mesh = n_pts = 0
    for prim in stage.Traverse():
        if not prim.IsA(UsdGeom.Mesh):
            continue
        mesh = UsdGeom.Mesh(prim)
        points = mesh.GetPointsAttr().Get()
        counts = mesh.GetFaceVertexCountsAttr().Get()
        indices = mesh.GetFaceVertexIndicesAttr().Get()
        if not points or not counts:
            continue

        verts = np.array(points, dtype=np.float64)
        faces = fan_triangulate(list(counts), list(indices))
        xf = np.array(UsdGeom.Xformable(prim).ComputeLocalToWorldTransform(Usd.TimeCode.Default())).T
        verts = (xf @ np.hstack([verts, np.ones((len(verts), 1))]).T).T[:, :3]

        tm = trimesh.Trimesh(vertices=verts, faces=faces, process=False)
        color = mesh_color(mesh, len(verts))
        if color is not None:
            tm.visual.vertex_colors = color
        scene.add_geometry(tm, node_name=str(prim.GetPath()))
        n_mesh += 1
        n_pts += len(verts)

    if n_mesh == 0:
        sys.exit(f"{PROG}: no UsdGeomMesh prims found in {path}")
    print(f"{PROG}: {n_mesh} mesh(es), {n_pts:,} verts", file=sys.stderr)
    return scene


def main() -> None:
    p = argparse.ArgumentParser(prog=PROG, description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("path", type=Path)
    args = p.parse_args()
    if not args.path.is_file():
        sys.exit(f"{PROG}: no such file: {args.path}")
    load_usd_scene(args.path).show()


if __name__ == "__main__":
    main()
