# macOS
.DS_Store

# rendered artifacts (install.sh generates these from *.tmpl)
*/Library/LaunchAgents/*.plist

# runtime/state — logs, sockets, caches, sessions
*.log
*.sock
*/.config/herdr/session.json
*/.config/herdr/release-notes.json
*/.config/herdr/branch-label-cache/
*/.config/herdr/herdr-*.log

# --- hard guards: never track secrets/PII, only the *.example templates ---
# real per-user config seeded from the .example files stays local:
**/scripts/standup_config.json
**/scripts/devices.txt
# machine-local Claude overrides + credentials + history + transcripts:
**/.claude/settings.local.json
**/.claude/.credentials.json
**/.claude/history.jsonl
**/.claude/projects/
**/.claude/sessions/
**/.claude/session-env/
**/.claude/file-history/
**/.claude/paste-cache/
**/.claude/shell-snapshots/
**/.claude/.venv/
__pycache__/
*.pyc
