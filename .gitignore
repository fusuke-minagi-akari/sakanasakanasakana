# macOS
.DS_Store

# rendered artifacts (generated by install.sh from *.tmpl)
home/Library/LaunchAgents/*.plist

# never track runtime/state — logs, sockets, caches, sessions
*.log
*.sock
home/.config/herdr/session.json
home/.config/herdr/release-notes.json
home/.config/herdr/branch-label-cache/
home/.config/herdr/herdr-*.log
