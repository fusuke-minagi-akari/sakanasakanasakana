      "Bash(pipenv --rm:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(halt:*)",
      "Bash(poweroff:*)",
      "Bash(systemctl stop:*)",
      "Bash(systemctl disable:*)",
      "Bash(launchctl unload:*)",
      "Bash(kill :*)",
      "Bash(kill -9:*)",
      "Bash(killall:*)",
      "Bash(pkill:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(dd :*)",
      "Bash(format:*)",
      "Bash(diskutil eraseDisk:*)",
      "Bash(diskutil eraseVolume:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fx:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout -- .:*)",
      "Bash(git restore .:*)",
      "Bash(ssh *rm *)",
      "Bash(ssh *rm -rf*)",
      "Bash(ssh *shutdown*)",
      "Bash(ssh *reboot*)",
      "Bash(git push --force*)",
      "Bash(rm -rf*)",
      "Bash(rm -f*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git clean*)",
      "Bash(wget*)",
      "Bash(npm publish*)",
      "Bash(pip install*)",
      "Bash(brew install*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/skills/token-usage/session_export.py > /tmp/session_export.log 2>&1"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-claude-done.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/keep-going.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/scripts/claude-status/statusline.sh\""
  },
  "enabledPlugins": {
    "caveman@caveman": false,
    "ponytail@ponytail": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "akari-awesome-cc-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/AKARI-Inc/awesome-cc.git"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "language": "english, japanese as secondary",
  "feedbackDrafts": "off",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "switchModelsOnFlag": true,
  "autoMode": {
    "environment": [
