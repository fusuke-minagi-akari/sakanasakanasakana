      "Bash(rm -f:*)",
      "Bash(rmdir:*)",
      "Bash(shred:*)",
      "Bash(unlink:*)",
      "Bash(truncate:*)",
      "Bash(srm:*)",
      "Bash(trash:*)",
      "Bash(rsync --delete:*)",
      "Bash(rsync *--delete*)",
      "Bash(docker rm:*)",
      "Bash(docker rmi:*)",
      "Bash(docker container rm:*)",
      "Bash(docker container prune:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker network rm:*)",
      "Bash(docker network prune:*)",
      "Bash(docker image prune:*)",
      "Bash(docker compose down --volumes:*)",
      "Bash(docker compose down -v:*)",
      "Bash(vagrant destroy:*)",
      "Bash(vboxmanage unregistervm:*)",
      "Bash(virsh destroy:*)",
      "Bash(virsh undefine:*)",
      "Bash(conda remove:*)",
      "Bash(conda env remove:*)",
