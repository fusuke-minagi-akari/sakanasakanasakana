#!/usr/bin/env bash
# clip <path> [path...] — put file(s) on the macOS clipboard as file objects,
# so you can paste them into Finder, Mail, chat apps, etc. (osascript).
# macOS counterpart of linux/.local/bin/clip (which uses xclip on X11).
set -euo pipefail

if [ "$#" -eq 0 ]; then
  echo "usage: clip <path> [path...]" >&2
  exit 1
fi

# Absolute path without needing GNU realpath (may be absent on macOS).
abspath() { cd "$(dirname -- "$1")" && printf '%s/%s' "$(pwd)" "$(basename -- "$1")"; }

esc_of() { local p; p="$(abspath "$1")"; p=${p//\\/\\\\}; printf '%s' "${p//\"/\\\"}"; }

for f in "$@"; do [ -e "$f" ] || { echo "clip: no such path: $f" >&2; exit 1; }; done

# A directory means "the files in it" (chat apps refuse a pasted folder). Top level only, no dotfiles.
paths=()
for f in "$@"; do
  if [ -d "$f" ]; then
    for g in "${f%/}"/*; do [ -f "$g" ] && paths+=("$(abspath "$g")"); done
  else
    paths+=("$(abspath "$f")")
  fi
done
[ "${#paths[@]}" -gt 0 ] || { echo "clip: no files in: $*" >&2; exit 1; }
set -- "${paths[@]}"

if [ "$#" -eq 1 ]; then
  # single file → a real file reference («class furl»), pastes as a file in Finder/Mail/chat
  osascript -e "set the clipboard to POSIX file \"$(esc_of "$1")\""
else
  # multiple → a filename list through NSPasteboard. An AppleScript list of POSIX files lands as a bare
  # «list» that nothing can paste, and writeObjects(NSURL) is lazy: items vanish once this process exits.
  osascript -l JavaScript -e 'ObjC.import("AppKit"); function run(argv){ const pb=$.NSPasteboard.generalPasteboard; pb.clearContents; pb.declareTypesOwner($(["NSFilenamesPboardType"]), null); if(!pb.setPropertyListForType($(argv), "NSFilenamesPboardType")) throw new Error("pasteboard write failed"); }' "$@" >/dev/null
fi

n="$#"
echo "clip: $n file$([ "$n" -ne 1 ] && echo s) on clipboard (paste as file)" >&2
